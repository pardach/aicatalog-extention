{
  "name": "new-illustrator-extension",
  "version": "1.0.0",
  "description": "اکستنشن جدید Adobe Illustrator - ساختار پایه",
  "main": "client/index.html",
  "scripts": {
    "build": "echo 'CEP extensions are built by copying files to the extensions directory'",
    "dev": "echo 'For development, copy the extension folder to Adobe CEP extensions directory'",
    "package": "echo 'Package the extension for distribution'",
    "install:win": "install.bat",
    "test": "node tests/run-all.js",
    "lint": "eslint js/*.js --fix || echo 'ESLint not installed'",
    "docs": "jsdoc js/*.js -d docs/api || echo 'JSDoc not installed'"
  },
  "keywords": [
    "adobe",
    "illustrator",
    "cep",
    "extension",
    "persian",
    "farsi"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pardach/aicatalog-extention.git"
  },
  "bugs": {
    "url": "https://github.com/pardach/aicatalog-extention/issues"
  },
  "homepage": "https://github.com/pardach/aicatalog-extention#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {},
  "devDependencies": {},
  "cep": {
    "version": "7.0",
    "hosts": {
      "ILST": {
        "version": "[23.0,99.9]",
        "name": "Adobe Illustrator"
      }
    },
    "requiredRuntime": {
      "name": "CSXS",
      "version": "9.0"
    },
    "extension": {
      "id": "com.yourcompany.newextension.panel",
      "version": "1.0.0",
      "name": "اکستنشن جدید"
    }
  },
  "compatibility": {
    "illustrator": {
      "min": "2019",
      "minHost": "23.0",
      "max": "unverified",
      "notes": "CEP-capable hosts only; actual host testing required"
    },
    "cep": {
      "min": "9.0",
      "target": [
        "9",
        "10",
        "11",
        "12"
      ]
    },
    "os": [
      "win32",
      "darwin"
    ]
  },
  "features": [
    "پنل پایه",
    "ارتباط با Illustrator",
    "رابط کاربری فارسی"
  ]
}
